					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 201 Created', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test('Generated Porsche Code and calculated MSRP pricing', function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.be.true;",
									"    pm.expect(jsonData.data.porscheCode).to.be.a('string');",
									"    pm.expect(jsonData.data.totalPrice).to.be.above(0);",
									"    pm.expect(jsonData.data.options).to.be.an('array').with.lengthOf(2);",
									"    pm.collectionVariables.set('porscheCode', jsonData.data.porscheCode);",
