								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{authToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Invalid Conflict Spec\",\n    \"modelId\": \"911\",\n    \"trimId\": \"carrera\",\n    \"colorId\": \"c_guards_red\",\n    \"wheelId\": \"w_carrera_19_20\",\n    \"interiorId\": \"leather_black\",\n    \"selectedOptions\": [\"opt_pccb\"],\n    \"currency\": \"EUR\"\n}"
						},
