			"name": "1. Аутентификация (Auth)",
			"item": [
				{
					"name": "1.1 Регистрация пользователя (201 Created)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"const ts = Date.now();",
									"pm.environment.set('reg_username', 'driver_' + ts);",
									"pm.environment.set('reg_email', 'driver_' + ts + '@porsche.de');"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 201 Created', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test('Response contains valid JWT token and user details', function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.be.true;",
									"    pm.expect(jsonData.data).to.have.property('token');",
									"    pm.expect(jsonData.data.user).to.have.property('id');",
									"    pm.collectionVariables.set('authToken', jsonData.data.token);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"{{reg_username}}\",\n    \"email\": \"{{reg_email}}\",\n    \"password\": \"PorscheFast#2026\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"register"
							]
						}
					}
				},
