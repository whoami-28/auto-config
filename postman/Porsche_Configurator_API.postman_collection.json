					"name": "2.2 Полный каталог моделей, отделок и опций (200 OK)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Catalog contains all models including Macan and Cayenne', function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.be.true;",
									"    const models = jsonData.data.models;",
									"    pm.expect(models).to.be.an('array');",
									"    pm.expect(models.length).to.be.at.least(6);",
									"    const modelIds = models.map(m => m.id);",
									"    pm.expect(modelIds).to.include.members(['911', '718', 'taycan', 'panamera', 'macan', 'cayenne']);",
									"});",
									"",
									"pm.test('Catalog contains distinct interior leather options', function () {",
									"    const jsonData = pm.response.json();",
									"    const interiors = jsonData.data.interiors;",
									"    pm.expect(interiors.length).to.be.at.least(4);",
									"    const interiorIds = interiors.map(i => i.id);",
									"    pm.expect(interiorIds).to.include.members(['leather_bordeaux', 'leather_racetex', 'leather_truffle']);",
